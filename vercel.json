{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/upload", "dest": "/api/upload.py" },
    { "src": "/api/chat",   "dest": "/api/chat.py"   },
    { "src": "/api/list",   "dest": "/api/list.py"   },
    { "src": "/(.*)",       "dest": "/public/$1"      }
  ]
}
